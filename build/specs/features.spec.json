  "cfgColumns": {
    "onlineV4ColCount": 12,
    "onlineV5ColCount": 11,
    "onlineV4SkillCol": 3
  },
  "fingerprint": {
    "external": [
      "AcceptableValueRange`1.Min",
      "AcceptableValueRange`1.Max"
    ],
    "member_aliases": {
      "GamePlayer.set_NetworkHandicap": "NetworkHandicap"
    },
    "note": "外部组件条目跳过离线比对；属性 getter/setter 按属性名匹配。"
  },
  "ui": {
    "scroll_restore": "per-page",
    "wheel_positive": "up",
    "layers": "UiLayer",
    "note": "页级 ViewState 由 SrPageModel 的编译期常量驱动；29 页节点树由 ui.pages.json 声明，绘制仍由各功能自己负责（双轨，未切换）。",
    "page_model": "build/specs/ui.pages.json"
  },
  "cfg": {
    "schema": 3,
    "stamp_suffix": ".schema",
    "note": "schema 不匹配时归档旧 cfg 并重建；不做旧键搬运。"
  },
  "build": {
    "sdk": "8.0.100",
    "roll_forward": "latestFeature",
    "target_framework": "net472",
    "lang_version": "7.3",
    "bcl": [
      "mscorlib",
      "netstandard",
      "System",
      "System.Core",
      "System.Xml"
    ],
    "game": [
      {
        "name": "Assembly-CSharp",
        "dir": "managed"
      },
      {
        "name": "UnityEngine",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.CoreModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.UNETModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.IMGUIModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.InputLegacyModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.Physics2DModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.TextRenderingModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.UI",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.UIModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.AudioModule",
        "dir": "managed"
      },
      {
        "name": "UnityEngine.AnimationModule",
        "dir": "managed"
      },
      {
        "name": "InControl",
        "dir": "managed"
      },
      {
        "name": "com.unity.multiplayer-hlapi.Runtime",
        "dir": "managed"
      },
      {
        "name": "AK.Wwise.Unity.API",
        "dir": "managed"
      },
      {
        "name": "BepInEx",
        "dir": "bepinex"
      },
      {
        "name": "0Harmony",
        "dir": "bepinex"
      }
    ],
    "stub_mode": "requires-game-managed",
    "note": "引用清单唯一真值：references.props 与 sr_uch.rsp 的 /r: 行均由本段派生。"
  },
  "net": {
    "messages": [
      {
        "name": "ChaosRule",
        "const": "ChaosRule",
        "authority": "host",
        "payload": "rule"
      },
      {
        "name": "ChaosCard",
        "const": "ChaosCard",
        "authority": "host",
        "payload": "card"
      },
      {
        "name": "ChaosHello",
        "const": "ChaosHello",
        "authority": "any",
        "payload": "hello"
      },
      {
        "name": "ChaosKill",
        "const": "ChaosKill",
        "authority": "host",
        "payload": "clear"
      }
    ],
    "note": "消息号只引用 NetMsgId 常量；权威要求由收发层读取。"
  },
  "toolchain": {
    "entry": "python3 tools/uch.py <verify|gen|impact|codemod|smoke|ship|seal|doctor|trace-gate|docs|add|remove>",
    "ci_entry_command": "python3 tools/uch.py verify --strict",
    "rsp_scope": {
      "checked": [
        "sr_uch.rsp"
      ],
      "external_exempt": [],
      "source_of_truth": "build/specs/generated/sources.manifest.json:compile",
      "note": "单链构建：只有 sr_uch.rsp；EX 与独立插件的源码和清单都在各自项目。"
    },
    "note": "唯一维护入口。CI 与本地只调 uch.py；各 check_*.py 保留为可独立运行的权威实现。不再设文件数 / 行数 / 工具模块集合上限：判定逻辑只有一份，靠对账发现漂移。",
    "required_spec_schema": 3,
    "api_level_scope": {
      "root": "SR_UCH/Contracts",
      "exclude_dirs": [
        "SR_UCH/Contracts/Generated"
      ],
      "note": "API 棘轮只数手写契约的 public 行；生成物里的 public 常量不计入。生成器与 uch.py 共享本声明。"
    },
    "required_generated": [
      "architecture.generated.json",
      "artifacts.manifest.json",
      "compile.targets",
      "contract-fingerprint.json",
      "facts.generated.json",
      "health.schema.json",
      "ratchets.json",
      "references.props",
      "removal-plan.json",
      "selftest.expected.json",
      "sources.manifest.json",
      "spec.report.json",
      "ui-model.generated.json",
      "README_features.generated.md",
      "feature_index.generated.md",
      "checks.generated.json",
      "error-sites.generated.json",
      "ui-shadow.generated.json",
      "health.golden.json",
      "smoke.generated.json",
      "ship.checklist.json"
    ],
    "legacy_scripts": [
      "build/build.ps1",
      "build/run-tests.ps1",
      "tools/uch.py",
      "tools/spec_engine.py",
      "tools/uch_rules.py",
      "tools/maint_ops.py",
      "tools/materialize.py",
      "tools/check_architecture.py",
      "tools/check_uimodel.py"
    ],
    "retired_baselines": [
      "selftest-baseline.txt",
      "api_level.txt",
      "loc-coverage.txt",
      "ui-enabled.txt",
      "ui-raw-layout.txt",
      "file-size.txt",
      "silent-catch.txt",
      "slot-orphan.txt",
      "slot-optional.txt",
      "region-access.txt"
    ],
    "migrations": [
      {
        "id": "M01",
        "title": "声明单源化（spec → rsp / README / 基线）",
        "chk": "SPEC-002"
      },
      {
        "id": "M02",
        "title": "生命周期账本与生成物归位",
        "chk": "ARCH-001"
      },
      {
        "id": "M04",
        "title": "声明式页面模型（29 页 / 双轨）",
        "chk": "UI-001"
      },
      {
        "id": "M05",
        "title": "稳定本地化 ID 与 cfg schema 门",
        "chk": "CFG-001"
      },
      {
        "id": "M06",
        "title": "契约指纹 + 健康合流",
        "chk": "CONTRACT-002"
      },
      {
        "id": "M07",
        "title": "构建图三链同源（references.props）",
        "chk": "GEN-005"
      },
      {
        "id": "M08",
        "title": "统一维护入口与 manifest 单一基线",
        "chk": "MANIFEST-001"
      },
      {
        "id": "M09",
        "title": "单一声明引擎（pwsh 退薄壳）",
        "chk": "ENGINE-001"
      },
      {
        "id": "M10",
        "title": "结构化错误站点覆盖全部静默 catch",
        "chk": "ERROR-001"
      }
    ],
    "trace_gate": {
      "target_batch": 1,
      "mode": "enforce",
      "cutover_requested": false,
      "require_runtime_ab": true,
      "evidence": "build/specs/generated/ui-ab-evidence.json",
      "note": "声明层 READY 不等于可删旧 IMGUI；cutover_requested=true 且实机 A/B 证据 verdict=PASS 才允许，否则 CI 红。"
    },
    "engine": "tools/spec_engine.py",
    "engine_note": "唯一解析器：pwsh 薄壳只转发；生成器/守卫/CI 不再各写一套判定。",
    "generated_policy": {
      "review_fold": ".gitattributes linguist-generated",
      "committed": "baselines-only",
      "committed_files": [
        "build/api_surface.txt",
        "build/specs/generated/contract-fingerprint.json",
        "build/specs/generated/ratchets.json",
        "build/specs/generated/health.schema.json",
        "build/specs/generated/selftest.expected.json",
        "build/specs/generated/removal-plan.json",
        "SR_UCH/Contracts/Generated/NetMessages.g.cs",
        "SR_UCH/Contracts/Generated/SrBuildGraph.g.cs",
        "SR_UCH/Contracts/Generated/SrStateMap.g.cs"
      ],
      "materialize_command": "python3 tools/uch.py materialize",
      "reason": "纯派生物（rsp / 派生 json / 可生成 .g.cs）不入库；历史基线、唯一绑定表与手写编译输入必须入库，否则守卫失去比较基准。"
    }
  },
  "external_plugins": {
    "policy": "log",
    "note": "log=未登记仍加载但告警；strict=只加载 allowlist。清单为空时全部按未登记处理。",
    "allowlist": []
  },
