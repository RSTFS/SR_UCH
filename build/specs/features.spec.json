{
  "schema": 3,
  "purpose": "注册与产物的唯一声明；源文件清单、注册点计数、槽位解析一律由生成器扫描派生，不写入本文件",
  "policy": {
    "phase": 5,
    "verify_mode": "strict",
    "features_baseline_semantics": "exact",
    "reflection_expectation": "Ref.Override 字面量 key 去重数（运行时 _refFeature.Count）",
    "readonly_in_phase1": false,
    "readme_generated_blocks": true,
    "region_access": [
      "_allEnabledEntry",
      "_allSections",
      "_appliedDisabled",
      "_blockInputEntry",
      "_captureStartFrame",
      "_capturing",
      "_cursorMoveTex",
      "_cursorResizeTex",
      "_cursorTex",
      "_dirty",
      "_disabledPluginsEntry",
      "_externalPlugins",
      "_font",
      "_forceZh",
      "_gatedEventSystem",
      "_gripTex",
      "_internalConfig",
      "_internalSections",
      "_langEn",
      "_langEntry",
      "_langVer",
      "_leftScroll",
      "_mode",
      "_nameWCached",
      "_nameWKey",
      "_openKey",
      "_pluginKey",
      "_prevBoxed",
      "_prevFont",
      "_recHeld",
      "_recSeq",
      "_rmbConsumedFrame",
      "_scaled",
      "_scroll",
      "_selectedInternalSection",
      "_styleList",
      "_stylesReady",
      "_uiAlpha",
      "_uiScaleEntry",
      "_userHiddenSections",
      "_visible",
      "_winHeight",
      "_winWidth",
      "_winX",
      "_winY",
      "_auditIssues",
      "_navHidden",
      "_patchAudited",
      "_refAudited",
      "_refWarned",
      "_startupAudited",
      "_removedKeysLog",
      "_appliedRemovals",
      "_appliedOldKeys",
      "_appliedOldSections",
      "_appliedMoves"
    ]
  },
  "artifacts": {
    "dll": "SR_UCH.dll",
    "deploy_target": "BepInEx\\plugins"
  },
  "deployment": {
    "schema": 1,
    "mode": "single",
    "dll": "SR_UCH.dll",
    "contract_version": 2,
    "api_level": 16,
    "core_provides": [
      "sr.selftest.token"
    ],
    "note": "单一产物 SR_UCH.dll；功能同程序集，跨组协作直接走编译期常量，不再有缺件影响面。"
  },
  "ci": {
    "workflow": ".github/workflows/guards.yml",
    "job": "guards",
    "command": "python3 tools/uch.py verify --strict",
    "strict_from_phase": 3
  },
  "architecture": {
    "note": "目录即层；依赖方向由 tools/check_architecture.py 检查，派生产物由 tools/spec_engine.py 重写。新增 .cs 必须落在某层，生成物统一放 Generated/；契约层枚举一律递归，独立编译清单与完整构建同源。",
    "layers": [
      {
        "id": "pure",
        "dirs": [
          "Pure"
        ],
        "may_reference": [
          "bcl"
        ],
        "forbid": [
          "UnityEngine",
          "BepInEx",
          "HarmonyLib",
          "SR_UCH.Tweaks"
        ],
        "desc": "纯函数；不得引用引擎、插件宿主或任何上层类型"
      },
      {
        "id": "contracts",
        "dirs": [
          "SR_UCH/Contracts",
          "SR_UCH/Contracts/Generated"
        ],
        "may_reference": [
          "pure",
          "bcl",
          "engine"
        ],
        "forbid": [
          "SR_UCH.Tweaks",
          "Features/ 声明的类型"
        ],
        "desc": "契约与运行时基础设施；不得依赖核心实现或功能层"
      },
      {
        "id": "core",
        "dirs": [
          "SR_UCH"
        ],
        "may_reference": [
          "pure",
          "contracts",
          "engine"
        ],
        "forbid": [
          "Features/ 声明的类型"
        ],
        "desc": "框架本体（partial class SR）：窗口 / 控件 / 钩子 / 诊断，不含任何功能；功能一律在 Features/"
      },
      {
        "id": "features",
        "dirs": [
          "Features"
        ],
        "may_reference": [
          "pure",
          "contracts",
          "core",
          "engine"
        ],
        "forbid": [],
        "desc": "功能层；跨功能协作走契约层强类型能力容器，不直接改核心私有状态"
      },
      {
        "id": "bootstrap",
        "dirs": [
          ".",
          "tests"
        ],
        "may_reference": [
          "pure",
          "contracts",
          "core",
          "features",
          "engine"
        ],
        "forbid": [],
        "desc": "装配根与测试；允许引用全部层"
      }
    ],
    "rules": [
      {
        "id": "pure-no-engine",
        "layer": "pure",
        "severity": "error"
      },
      {
        "id": "contracts-no-core",
        "layer": "contracts",
        "severity": "error"
      },
      {
        "id": "contracts-no-features",
        "layer": "contracts",
        "severity": "error"
      },
      {
        "id": "core-no-features",
        "layer": "core",
        "severity": "error"
      },
      {
        "id": "generated-separated",
        "severity": "error"
      },
      {
        "id": "no-unlayered",
        "severity": "error"
      }
    ]
  },
  "layers": {
    "group": "功能分组（文档 / 归属粒度）",
    "feature": "逻辑功能（SrFeature 粒度）",
    "lease": "运行时作用域（FeatureRuntime：幂等装载 / 注册归属 / 自动撤销）"
  },
