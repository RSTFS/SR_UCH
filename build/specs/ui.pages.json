{
  "schema": 1,
  "note": "页面声明由源码 RegisterPage 派生；节点树仅供逐批轨迹断言，不参与当前运行时绘制，也不是路由表（运行时路由以源码 RegisterPage / DrawGUI 为准）。",
  "rules": {
    "scroll_policies": [
      "per-page",
      "reset-on-switch"
    ],
    "layers": [
      "content",
      "overlay",
      "hud"
    ],
    "forbid_nested_scroll_view": true,
    "root_scroll_file": "SR_UCH/SR.Window.cs",
    "batches": {
      "1": "规整配置页",
      "2": "列表与重 Rect",
      "3": "纯自绘卡片"
    },
    "batch2_rect_threshold": 12,
    "page_dispatch": "registry",
    "note": "页面级滚动区只由主窗口建立；功能页不得再套 ScrollView。策略按 section 聚合，同 section 必须一致。"
  },
