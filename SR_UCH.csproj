<Project Sdk="Microsoft.NET.Sdk">

  <!-- SR_UCH 主模块：入口 MainPlugin.cs + SR_UCH/ 下的核心（管理器）+ Features/ 下各功能源码。
       本工程只服务于 IDE / MSBuild（VS、Rider、dotnet build）里看代码、查游戏 API 与编译；
       ⚠ 要部署进游戏的那一份必须由 _tools\build_sr_uch.ps1 产出（csc + 游戏自带 mscorlib/
       UnityEngine），本工程用的是 .NET Framework 参考程序集，二者不可混用 → 输出刻意分家。
       运行期结构：单一 SR_UCH.dll，全部功能同程序集；实现 ITweak 即被自动发现。 -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SR_UCH</AssemblyName>
    <RootNamespace>SR_UCH</RootNamespace>

    <!-- 硬约束：BepInEx 5.4 / Harmony 2 / Unity 老 Mono → C# 7.3（禁 switch 表达式/可空引用等） -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 旧 Mono / net472：不生成 ref assembly 与多余程序集属性 -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <!-- 游戏自带 Unity 程序集互相之间存在版本差异，SDK 10 会把这类 MSB3277 当错误；
         csc 路线（build.ps1 主路径）不会。这里显式降级，避免新 SDK 上无法构建。 -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <!-- 显式列源码，避免构建产物被误纳入。 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\MSBuild\</OutputPath>

    <!-- 游戏根目录的单一真值：优先环境变量 UCH_DIR，未设置时用下面的回退值（**仅供作者本机**，评审 G2）。
         换机器 / 新克隆请 setx UCH_DIR "E:\...\Ultimate Chicken Horse"，或
         dotnet build -p:UCH_DIR="E:\...\Ultimate Chicken Horse"（也可直接 -p:UchManagedDir=...）。
         回退值不匹配时 CheckUchDir 会给出可操作的报错，不会只丢一堆 CS0006。 -->
    <UCH_DIR Condition="'$(UCH_DIR)' == ''">D:\EF\Steam\steamapps\common\Ultimate Chicken Horse</UCH_DIR>
    <UchManagedDir Condition="'$(UchManagedDir)' == ''">$(UCH_DIR)\UltimateChickenHorse_Data\Managed</UchManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(UCH_DIR)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <!-- 路径探测失败给出明确报错：旧版写死作者本机路径，换机器只会看到一堆 CS0006。 -->
  <Target Name="CheckUchDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(UchManagedDir)\Assembly-CSharp.dll')"
           Text="找不到游戏程序集：$(UchManagedDir)&#10;请设置环境变量 UCH_DIR（游戏根目录），或 dotnet build -p:UCH_DIR=... / -p:UchManagedDir=..." />
  </Target>

  <!-- 源码清单由 build/specs/generated/sources.manifest.json 派生；rsp 与 IDE 工程共用一份。
       部署产物由 build/build.ps1 按 build/specs/features.spec.json 生成。 -->
  <Import Project="build\specs\generated\compile.targets" />

  <!-- net472 目标包：让只装了 .NET SDK、没装 .NET Framework 开发包的机器也能编译 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏 / BepInEx 引用由 build/specs/generated/references.props 生成。 -->
  <Import Project="build\specs\generated\references.props" />

</Project>

