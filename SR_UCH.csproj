<Project Sdk="Microsoft.NET.Sdk">

  <!-- SR_UCH 主模块：入口 MainPlugin.cs + SR_UCH/ 下全部源码。
       本工程只服务于 IDE / MSBuild（VS、Rider、dotnet build）里看代码、查游戏 API 与编译；
       ⚠ 要部署进游戏的那一份必须由 _tools\build_sr_uch.ps1 产出（csc + 游戏自带 mscorlib/
       UnityEngine），本工程用的是 .NET Framework 参考程序集，二者不可混用 → 输出刻意分家。 -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SR_UCH</AssemblyName>
    <RootNamespace>SR_UCH</RootNamespace>

    <!-- 硬约束：BepInEx 5.4 / Harmony 2 / Unity 老 Mono → C# 7.3（禁 switch 表达式/可空引用等） -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 旧 Mono / net472：不生成 ref assembly 与多余程序集属性 -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0618</NoWarn>

    <!-- 显式列源码，避免 bin/、obj/ 等被误纳入（新增 SR_UCH\*.cs 会自动跟上） -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\MSBuild\</OutputPath>

    <!-- 本机游戏路径：可在命令行覆盖，如
         dotnet build -p:UchManagedDir="D:\Steam\...\UltimateChickenHorse_Data\Managed" -->
    <UchManagedDir Condition="'$(UchManagedDir)' == ''">D:\EF\Steam\steamapps\common\Ultimate Chicken Horse\UltimateChickenHorse_Data\Managed</UchManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">D:\EF\Steam\steamapps\common\Ultimate Chicken Horse\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MainPlugin.cs" />
    <Compile Include="SR_UCH\**\*.cs" />
  </ItemGroup>

  <!-- net472 目标包：让只装了 .NET SDK、没装 .NET Framework 开发包的机器也能编译 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏程序集 + Unity 模块 + 联机/输入/音频 + BepInEx/Harmony（与 sr_uch.rsp 一致） -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(UchManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UchManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UchManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UNETModule">
      <HintPath>$(UchManagedDir)\UnityEngine.UNETModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UchManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UchManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(UchManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UchManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UchManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UchManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UchManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InControl">
      <HintPath>$(UchManagedDir)\InControl.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime">
      <HintPath>$(UchManagedDir)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AK.Wwise.Unity.API">
      <HintPath>$(UchManagedDir)\AK.Wwise.Unity.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
